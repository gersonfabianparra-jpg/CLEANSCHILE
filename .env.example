# === DATABASE (Neon PostgreSQL) ===
# 1. Ve a https://neon.tech → New Project → copia la DATABASE_URL
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# === NEXTAUTH ===
# Genera un secret aleatorio con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-secret-super-seguro-aqui"
NEXTAUTH_URL="http://localhost:3000"
# En producción: NEXTAUTH_URL="https://tu-dominio.vercel.app"

# === EMAIL - RESEND (opcional) ===
# 1. Ve a https://resend.com → API Keys → Create Key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
